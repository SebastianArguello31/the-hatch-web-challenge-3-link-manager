# Puerto HTTP del backend. Copia esta plantilla a .env y completa tus datos locales.
PORT=3000

# El driver pg utiliza estas variables para conectarse a PostgreSQL.
PGHOST=localhost
PGPORT=5432
PGDATABASE=link_organizer
PGUSER=postgres
PGPASSWORD=REEMPLAZAR_LOCALMENTE

# Orígenes de React y Vanilla permitidos por CORS, separados por comas.
CLIENT_ORIGINS=http://localhost:5173,http://localhost:5500
